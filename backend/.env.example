# ── Provider selector ─────────────────────────────────────────────────────────
# Options: claude | openrouter | ollama
LLM_PROVIDER=openrouter

# ── Claude (LLM_PROVIDER=claude) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Valid IDs as of Sept 2026. claude-opus-4-6 no longer exists.
#   claude-sonnet-5              $2/$10 per MTok  <- default, best balance here
#   claude-haiku-4-5-20251001    $1/$5            fastest, fine for this JSON task
#   claude-opus-5                $5/$25           overkill for short JSON
CLAUDE_MODEL=claude-sonnet-5          # optional, this is the default

# ── OpenRouter (LLM_PROVIDER=openrouter) ─────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct   # optional, this is the default
# Free alternatives:
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free

# ── Ollama (LLM_PROVIDER=ollama) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1   # optional, this is the default
OLLAMA_MODEL=qwen2.5-coder:7b              # optional, this is the default

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
